# Local environment. Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit credentials.

# Supabase (public — these get bundled into client JS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AdSense (public — these get bundled into client JS)
# Ad unit ids from the AdSense dashboard. Leave blank to hide that slot.
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# OpenF1 (private) — token for live standings and results
OPENF1_ACCESS_TOKEN=

# News / RSS feed
NEWS_API_URL=

# Facebook page (private)
FB_RSS_URL=
FB_PAGE_ID=
FB_PAGE_NAME=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v23.0
